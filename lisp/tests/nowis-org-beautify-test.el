;;; nowis-org-beautify-test.el --- Org typography tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'nowis-org-beautify)

(ert-deftest nowis-org-beautify-toggle-is-reversible-and-idempotent ()
  (with-temp-buffer
    (org-mode)
    (setq-local line-spacing 0.35)
    (text-scale-set 2)
    (let* ((external (face-remap-add-relative 'org-table '(:foreground "red")))
           (before (copy-tree face-remapping-alist)))
      (nowis-org-beautify-mode 1)
      (should (= line-spacing nowis-org-beautify-line-spacing))
      (should (member '(:inherit variable-pitch)
                      (cdr (assq 'default face-remapping-alist))))
      (dolist (face nowis-org-beautify--fixed-pitch-faces)
        (when (facep face)
          (should (member '(:inherit fixed-pitch :height 1.0)
                          (cdr (assq face face-remapping-alist))))))
      (should (member '(:inherit variable-pitch :height 1.3 :weight bold)
                      (cdr (assq 'org-level-1 face-remapping-alist))))
      (let ((enabled (copy-tree face-remapping-alist)))
        (nowis-org-beautify-mode 1)
        (should (equal enabled face-remapping-alist)))
      ;; Remappings added by another mode while active must also survive.
      (let ((later (face-remap-add-relative 'org-code '(:foreground "blue"))))
        (nowis-org-beautify-mode -1)
        (should (memq (cdr later) (cdr (assq 'org-code face-remapping-alist))))
        (face-remap-remove-relative later))
      (should (equal before face-remapping-alist))
      (should (= line-spacing 0.35))
      (should (local-variable-p 'line-spacing))
      (should text-scale-mode)
      (should (= text-scale-mode-amount 2))
      (nowis-org-beautify-mode -1)
      (should (= line-spacing 0.35))
      (face-remap-remove-relative external))))

(ert-deftest nowis-org-beautify-restores-inherited-line-spacing ()
  (with-temp-buffer
    (org-mode)
    (let ((inherited line-spacing))
      (should-not (local-variable-p 'line-spacing))
      (nowis-org-beautify-mode 1)
      (should (local-variable-p 'line-spacing))
      (nowis-org-beautify-mode -1)
      (should-not (local-variable-p 'line-spacing))
      (should (equal line-spacing inherited)))))

(ert-deftest nowis-org-beautify-preserves-existing-buffer-face-mode ()
  (dolist (face '(variable-pitch (:family "monospace" :height 1.1)))
    (with-temp-buffer
      (org-mode)
      (buffer-face-set face)
      (let ((before (copy-tree face-remapping-alist)))
        (nowis-org-beautify-mode 1)
        (should buffer-face-mode)
        (should (equal buffer-face-mode-face face))
        (nowis-org-beautify-mode -1)
        (should buffer-face-mode)
        (should (equal buffer-face-mode-face face))
        (should (equal before face-remapping-alist))))))

(ert-deftest nowis-org-beautify-only-changes-current-buffer-display ()
  (with-temp-buffer
    (org-mode)
    (insert "* Heading\n正文 with prose, =inline code= and ~verbatim~.\n")
    (set-buffer-modified-p nil)
    (setq buffer-read-only t)
    (let ((text (buffer-string))
          (heading-face (face-all-attributes 'org-level-1))
          (table-face (face-all-attributes 'org-table)))
      (nowis-org-beautify-mode 1)
      (should-not (buffer-modified-p))
      (should (equal text (buffer-string)))
      (should (equal heading-face (face-all-attributes 'org-level-1)))
      (should (equal table-face (face-all-attributes 'org-table)))
      (with-temp-buffer
        (org-mode)
        (should-not nowis-org-beautify-mode)
        (should-not nowis-org-beautify--remappings)
        (should-not (assq 'org-table face-remapping-alist)))
      (nowis-org-beautify-mode -1)
      (should-not (buffer-modified-p)))))

(ert-deftest nowis-org-beautify-cleans-up-when-changing-major-mode ()
  (with-temp-buffer
    (org-mode)
    (nowis-org-beautify-mode 1)
    (fundamental-mode)
    (should-not nowis-org-beautify-mode)
    (should-not nowis-org-beautify--remappings)
    (should-not face-remapping-alist)
    (should-not (local-variable-p 'line-spacing))))

(ert-deftest nowis-org-beautify-rejects-non-org-buffers ()
  (with-temp-buffer
    (should-error (nowis-org-beautify-mode 1) :type 'user-error)
    (should-not nowis-org-beautify-mode)
    (should-not face-remapping-alist)
    (should-not (local-variable-p 'line-spacing))))

(ert-deftest nowis-org-beautify-covers-native-source-and-inline-code-faces ()
  (with-temp-buffer
    (org-mode)
    (insert "Prose =code= and ~verbatim~.\n\n| Name | Value |\n| one | 1 |\n\n#+begin_src emacs-lisp\n(message \"hello\")\n#+end_src\n\n#+begin_example\nexample text\n#+end_example\n")
    (nowis-org-beautify-mode 1)
    (font-lock-ensure)
    (dolist (entry '(("code" . org-verbatim)
                     ("verbatim" . org-code)
                     ("Name" . org-table)
                     ("message" . org-block)
                     ("example text" . org-block)))
      (goto-char (point-min))
      (search-forward (car entry))
      (let* ((face (get-text-property (match-beginning 0) 'face))
             (faces (if (listp face) face (list face))))
        (should (memq (cdr entry) faces))
        (should (assq (cdr entry) face-remapping-alist))))))

;;; nowis-org-beautify-test.el ends here
